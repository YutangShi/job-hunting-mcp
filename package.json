{
  "name": "job-hunting-mcp",
  "version": "0.1.0",
  "description": "MCP server for read-only job search across supported sources",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "smoke:104": "tsx scripts/smoke-104.ts",
    "smoke:cake": "tsx scripts/smoke-cake.ts",
    "test:e2e": "npm run build && tsx --test tests/e2e/*.test.ts",
    "start": "node dist/index.js",
    "test:unit": "tsx --test tests/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "impers": "0.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
